    <script>
      // ─── MODALES (Salarios y Agencias) ───
      document.addEventListener('DOMContentLoaded', () => {
        // Modal Salarios
        const salaryModal = document.getElementById('salary-modal');
        const openSalaryBtns = document.querySelectorAll('.open-salary-modal');
