    <script>
      import EN_TO_ES from '../i18n/en-to-es.json';

      const devMsg = (es, en) => document.documentElement.lang === 'es' ? es : en;
      const CONTACT_ENDPOINT = 'https://growth.10xteam.com.mx/api/contact';
      const WEB3FORMS_ENDPOINT = 'https://api.web3forms.com/submit';
      const WEB3FORMS_KEY = 'fb41fe9d-42b5-4fa1-9a08-05e436321c6d';

      // ─── GEOLOCALIZACIÓN EN SEGUNDO PLANO (LEAD INTELLIGENCE) ───
      // Detecta procedencia para enriquecer leads; NO altera precios visuales.
      let detectedCountry = 'Desconocido';
      async function detectVisitorLocation() {
        try {
          const res = await fetch('https://api.country.is/');
          const data = await res.json();
          if (data && data.country) {
            detectedCountry = data.country;
            localStorage.setItem('10x_visitor_country', data.country);
          }
        } catch {
          const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
          detectedCountry = tz || 'No disponible';
          localStorage.setItem('10x_visitor_country', detectedCountry);
        }
      }

      document.addEventListener('DOMContentLoaded', () => {
        detectVisitorLocation();

        // ─── FORMULARIO GENERAL DE CONTACTO ───
        const contactForm = document.getElementById('contact-form');
        const contactStatus = document.getElementById('contact-form-status');
        if (contactForm instanceof HTMLFormElement && contactStatus) {
          contactForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const submitBtn = contactForm.querySelector('button[type="submit"]');
            const formData = new FormData(contactForm);
            const country = localStorage.getItem('10x_visitor_country') || detectedCountry;
            const name = formData.get('name') || '';
            const email = formData.get('email');
            const serviceType = formData.get('serviceType') || 'No especificado';
            const message = formData.get('message');

            formData.set('access_key', WEB3FORMS_KEY);
            formData.set('subject', `[LEAD DEV PROYECTO] Nuevo proyecto de ${name} (${country})`);
            formData.set('from_name', '10x Dev Leads');
            formData.set('detected_country', country);

            contactStatus.textContent = devMsg('Enviando...', 'Sending...');
            if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = true;

            try {
              const response = await fetch(WEB3FORMS_ENDPOINT, {
                method: 'POST',
                body: formData,
              });

              const result = await response.json();
              if (response.ok && result.success) {
                contactStatus.textContent = devMsg('Recibido. Te contactaremos en menos de 24h.', 'Received. We will get back to you within 24 hours.');
                contactForm.reset();

                // Respaldo en backend interno Supabase / growth
                fetch(CONTACT_ENDPOINT, {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({
                    name,
                    email,
                    serviceType,
                    message: `[PAÍS: ${country}]\n${message}`,
                    source: 'dev_contact',
                  }),
                }).catch(() => {});
              } else {
                throw new Error(result.message || 'request-failed');
              }
            } catch {
              contactStatus.textContent = devMsg('No pudimos enviar tu mensaje. Intenta de nuevo o escríbenos a fcb@10xteam.com.mx.', 'We could not submit your message. Please try again or email fcb@10xteam.com.mx.');
            } finally {
              if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = false;
            }
          });
        }

        // ─── FORMULARIO EXCLUSIVO DE AGENCIAS (WHITE-LABEL) ───
        const agencyForm = document.getElementById('agency-form');
        const agencyStatus = document.getElementById('agency-form-status');
        if (agencyForm instanceof HTMLFormElement && agencyStatus) {
          agencyForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const submitBtn = agencyForm.querySelector('button[type="submit"]');
            const formData = new FormData(agencyForm);
            const agencyName = formData.get('agencyName') || 'Agencia';
            const contactName = formData.get('contactName') || 'Contacto';
            const email = formData.get('email');
            const phone = formData.get('phone') || 'No provisto';
            const message = formData.get('message');
            const country = localStorage.getItem('10x_visitor_country') || detectedCountry;

            formData.set('access_key', WEB3FORMS_KEY);
            formData.set('subject', `[LEAD AGENCIA DEV] Solicitud Wholesale: ${agencyName} (${country})`);
            formData.set('from_name', 'dev.10xteam Wholesale');
            formData.set('detected_country', country);

            agencyStatus.textContent = devMsg('Enviando solicitud de alianza...', 'Submitting partnership request...');
            if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = true;

            try {
              const response = await fetch(WEB3FORMS_ENDPOINT, {
                method: 'POST',
                body: formData,
              });

              const result = await response.json();
              if (response.ok && result.success) {
                agencyStatus.textContent = devMsg('Solicitud recibida con éxito. Te contactaremos al correo para coordinar los detalles de la alianza.', 'Application received. We will email you to discuss partnership details.');
                agencyForm.reset();

                // Respaldo en backend interno Supabase / growth
                fetch(CONTACT_ENDPOINT, {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({
                    name: `${contactName} (${agencyName})`,
                    email,
                    phone: phone !== 'No provisto' ? phone : undefined,
                    serviceType: 'agency_wholesale',
                    message: `[SOLICITUD AGENCIA WHITE-LABEL]\n[PAÍS DETECTADO: ${country}]\n[AGENCIA: ${agencyName}]\n[CONTACTO: ${contactName}]\n[TEL/WHATSAPP: ${phone}]\n[NOTAS / PIPELINE]:\n${message}`,
                    source: 'agency_partner_lead',
                  }),
                }).catch(() => {});
              } else {
                throw new Error(result.message || 'request-failed');
              }
            } catch {
              agencyStatus.textContent = devMsg('Hubo un error al procesar tu solicitud. Por favor intenta de nuevo o escríbenos a fcb@10xteam.com.mx.', 'We could not process your application. Please try again or email fcb@10xteam.com.mx.');
            } finally {
              if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = false;
            }
          });
        }

        // ─── LOCALIZACIÓN: INGLÉS POR DEFECTO, ESPAÑOL OPCIONAL ───
        const langBtn = document.getElementById('lang-toggle-btn');
        // Cache the English source text before any language switch.
        // Text nodes preserve nested markup, icons and existing interactive elements.
        const localizedNodes = [];
        const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
          acceptNode(node) {
            const parent = node.parentElement;
            if (!parent || parent.closest('script, style, [data-es][data-en]')) {
              return NodeFilter.FILTER_REJECT;
            }
            const key = node.textContent?.trim() || '';
            return Object.prototype.hasOwnProperty.call(EN_TO_ES, key)
              ? NodeFilter.FILTER_ACCEPT
              : NodeFilter.FILTER_SKIP;
          },
        });
        let node;
        while ((node = walker.nextNode())) {
          const value = node.textContent || '';
          const en = value.trim();
          const offset = value.indexOf(en);
          localizedNodes.push({
            node, en, es: EN_TO_ES[en],
            prefix: value.slice(0, offset),
            suffix: value.slice(offset + en.length),
          });
        }

        const applyDevLanguage = (lang) => {
          const locale = lang === 'es' ? 'es' : 'en';
          document.documentElement.lang = locale;
          document.querySelectorAll('[data-es][data-en]').forEach(el => {
            el.textContent = el.getAttribute(locale === 'es' ? 'data-es' : 'data-en') || '';
          });
          localizedNodes.forEach(item => {
            item.node.textContent = item.prefix + (locale === 'es' ? item.es : item.en) + item.suffix;
          });
          document.querySelectorAll('[data-placeholder-en][data-placeholder-es]').forEach(el => {
            el.setAttribute('placeholder', el.getAttribute(locale === 'es' ? 'data-placeholder-es' : 'data-placeholder-en') || '');
          });
          const indicator = document.getElementById('lang-indicator');
          if (indicator) indicator.textContent = locale.toUpperCase();
          if (langBtn) langBtn.setAttribute('aria-label', locale === 'es' ? 'Cambiar idioma' : 'Switch language');
          document.title = locale === 'es'
            ? '10xTeam Dev | Desarrollo de Software, IA e Ingeniería Flexible'
            : '10xTeam Dev | Custom Software, AI & Flexible Engineering';
          const meta = document.querySelector('meta[name="description"]');
          if (meta) meta.setAttribute('content', locale === 'es'
            ? 'Desarrollo de software e IA a medida: proyectos desde $3,900 USD o 10x Dev Squad desde $4,900 USD/mes. Agenda una llamada de descubrimiento.'
            : 'Custom software and AI development: turnkey projects starting at $3,900 USD and 10x Dev Squad from $4,900 USD/month. Flexible engineering based on your scope. Book a free discovery call.');
          try { localStorage.setItem('10x_dev_lang', locale); } catch {}
        };
        const initialLanguage = (() => {
          try { return localStorage.getItem('10x_dev_lang') === 'es' ? 'es' : 'en'; }
          catch { return 'en'; }
        })();
        applyDevLanguage(initialLanguage);
        langBtn?.addEventListener('click', () => {
          applyDevLanguage(document.documentElement.lang === 'es' ? 'en' : 'es');
        });
      });
    </script>
