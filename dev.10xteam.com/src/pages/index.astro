---
import '../styles/global.css';
const pageTitle = "10xTeam Dev | Custom Software, AI & Flexible Engineering";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="theme-color" content="#060810" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
    <meta name="description" content="Custom software and AI development: turnkey projects starting at $3,900 USD and 10x Dev Squad from $4,900 USD/month. Flexible engineering based on your scope. Book a free discovery call." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
	</head>
	<body>
    <header class="navbar">
      <div class="container navbar-container">
        <a href="https://10xteam.com.mx" class="logo"><img src="/Logo_10xteam.png" alt="10xTeam" width="140" height="56" /></a>
        <nav class="nav-links" id="nav-links">
          <a href="#servicios" data-es="Servicios" data-en="Services">Services</a>
          <a href="#precios" data-es="Precios" data-en="Pricing">Pricing</a>
          <a href="#metodologia" data-es="Método" data-en="Method">Method</a>
          <a href="#nosotros" data-es="Nosotros" data-en="About">About</a>
          <a href="#testimonios" data-es="Casos" data-en="Cases">Cases</a>
        </nav>
        <div class="nav-actions">
          <button id="lang-toggle-btn" class="lang-toggle-btn" type="button" aria-label="Switch language">
            <span class="globe-icon">🌐</span>
            <span id="lang-indicator">EN</span>
          </button>
          <a href="#contacto" class="btn-primary btn-nav" data-es="Agendar Llamada" data-en="Book a Call">Book a Call</a>
        </div>
      </div>
    </header>

    <main>
      <!-- ════ HERO ════ -->
      <section class="hero">
        <div class="container">
          <div class="hero-title-area">
            <div class="badge">CUSTOM SOFTWARE · AI · FLEXIBLE ENGINEERING</div>
            <h1>
              <span class="title-part">We build technology</span>
              <span class="text-gradient title-part">that moves your business forward.</span>
            </h1>
            <p class="hero-subheading">From ambitious ideas to digital solutions that deliver real business value.</p>
          </div>
          <div class="hero-inner">
            <div class="hero-content">
              <div class="hero-description-area">
                <div class="hero-text-side">
                  <p class="hero-subtitle" style="margin-top: -1rem;">
                    We build custom software, SaaS platforms, applications, and AI-powered integrations. By combining business strategy, product design, and engineering expertise, we help companies grow, streamline operations, and unlock new opportunities.
                  </p>
                  <p class="hero-subtitle">
                    Access the specialists your project needs without the cost and complexity of building an entire in-house team. A smarter, more flexible way to turn ideas into scalable technology.
                  </p>
                  <div class="hero-proof-horizontal">
                    <div class="proof-item-hz"><span class="proof-number-hz">Expert Team</span><span class="proof-label-hz">+ AI</span></div>
                    <div class="proof-item-hz"><span class="proof-number-hz">Fast</span><span class="proof-label-hz">Kickoff</span></div>
                    <div class="proof-item-hz"><span class="proof-number-hz">Defined</span><span class="proof-label-hz">Deliverables</span></div>
                    <div class="proof-item-hz"><span class="proof-number-hz">Up to 50%</span><span class="proof-label-hz">Potential Savings</span></div>
                  </div>
                  <div class="hero-cta">
                    <a href="#contacto" class="btn-primary">Tell Us About Your Project →</a>
                    <a href="#precios" class="btn-outline btn-outline-visible">Explore Plans & Pricing</a>
                  </div>
                  <p class="text-muted" style="margin-top: 1.5rem; font-size: 0.85rem; border-left: 2px solid var(--accent-primary); padding-left: 1rem;">
                    Let's talk about what you're building. Your initial project assessment is free, with no obligation.
                  </p>
                </div>
              </div>
            </div>
            <div class="hero-visual">
              <div class="hero-image-wrap">
                <img src="/architecture-mockup1.png" alt="Architecture Roadmap Preview" class="hero-main-img" />
              </div>
            </div>
          </div>
        </div>
      </section>
      
      <!-- ════ SECCIÓN: ESTADÍSTICAS ════ -->
      <div class="stats-ribbon">
        <div class="container stats-container">
          <div class="stat-item">
            <span class="stat-number">28</span>
            <span class="stat-label">Projects delivered</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">3–5</span>
            <span class="stat-label">Estimated weeks per MVP</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">14</span>
            <span class="stat-label">Days per delivery cycle</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">0</span>
            <span class="stat-label">Additional in-house hires required</span>
          </div>
        </div>
      </div>

      <!-- ════ NUEVA SECCIÓN: MÉTODO 10X ════ -->
      <section id="metodo-10x" class="section">
        <div class="container">
          <div class="section-header text-center">
            <div class="badge">Our Approach</div>
            <h2>How do we make it<br /><span class="text-gradient">10x faster and more cost-effective?</span></h2>
          </div>
          <div class="services-grid method-grid">
            <div class="service-card glass-panel">
              <div class="card-title-hz">
                <div class="service-icon">🧠</div>
                <h3>Multi-Model AI</h3>
              </div>
              <p>We use purpose-built AI models for coding, design, QA and documentation. Instead of relying on a single tool, we combine models across the workflow. We automate approximately 60% of repetitive work to reduce cost and delivery time without compromising quality.</p>
            </div>
            <div class="service-card glass-panel">
              <div class="card-title-hz">
                <div class="service-icon">⚙️</div>
                <h3>Flexible Engineering Squads</h3>
              </div>
              <p>Every project draws on the expertise it needs: software architecture, business analysis, frontend and backend development, QA, UX/UI design and technical leadership. Specialists collaborate around your deliverables, without endless meetings.</p>
            </div>
            <div class="service-card glass-panel">
              <div class="card-title-hz">
                <div class="service-icon">💰</div>
                <h3>Built for Business Value</h3>
              </div>
              <p>We don't just write code. We consider monetization and cost efficiency so your software can become a valuable business asset from day one.</p>
            </div>
            <div class="service-card glass-panel">
              <div class="card-title-hz">
                <div class="service-icon">📦</div>
                <h3>Reusable Foundations, Faster Delivery</h3>
              </div>
              <p>Our library of proven components helps us kick off in 48 hours and deliver a functional MVP in as little as 21 days. Enterprise-grade execution without unnecessary bureaucracy.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ════ SERVICIOS ════ -->
      <section id="servicios" class="section">
        <div class="container">
          <div class="section-header text-center">
            <div class="badge">What We Build</div>
            <h2>Software Engineering<br />for Ambitious Businesses</h2>
            <p class="subtitle">We cover the full lifecycle of your digital product.<br />Focused delivery, without unnecessary delays.</p>
          </div>
          <div class="services-grid">
            <div class="service-card glass-panel">
              <div class="card-title-hz">
                <div class="service-icon">🌐</div>
                <h3>Web Platforms & SaaS</h3>
              </div>
              <p>Robust, scalable, conversion-focused systems: from landing pages to complex platforms with dashboards and payments.</p>
            </div>
            <div class="service-card glass-panel">
              <div class="card-title-hz">
                <div class="service-icon">📱</div>
                <h3>Mobile Apps</h3>
              </div>
              <p>Native and cross-platform iOS and Android apps with intuitive user experiences and optimized performance.</p>
            </div>
            <div class="service-card glass-panel">
              <div class="card-title-hz">
                <div class="service-icon">⚙️</div>
                <h3>Custom Systems & ERP Integrations</h3>
              </div>
              <p>Streamline operations with custom software that replaces spreadsheets and slow manual processes.</p>
            </div>
            <div class="service-card glass-panel">
              <div class="card-title-hz">
                <div class="service-icon">🤖</div>
                <h3>AI Integration</h3>
              </div>
              <p>Enhance your product with AI: conversational agents, intelligent automation, predictive analytics and more.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ════ PRECIOS ════ -->
      <section id="precios" class="section section-pricing">
        <div class="container">
          <div class="section-header text-center">
            <div class="badge" data-es="Precios transparentes" data-en="Transparent Pricing">Transparent Pricing</div>
            <h2 data-es="Elige cómo quieres trabajar con nosotros" data-en="Choose How to Work With Us">Choose How to Work With Us</h2>
            <p class="subtitle" data-es="Dos formas de construir: un proyecto llave en mano o una célula de producto que evoluciona contigo. Alcance y entregables definidos para cada necesidad." data-en="Two ways to build: a turnkey project or a product squad that evolves with you. Defined scope and deliverables for every need.">Two ways to build: a turnkey project or a product squad that evolves with you. Defined scope and deliverables for every need.</p>
          </div>
          <div class="pricing-grid">
            <!-- Card 1: MVP -->
            <div class="pricing-card glass-panel">
              <div class="card-top">
                <div class="card-title-hz">
                  <div class="plan-icon">🚀</div>
                  <h3>Turnkey Project</h3>
                </div>
                <p class="plan-desc" data-es="Desarrollo desde cero o MVP" data-en="Ground-up development or MVP">Ground-up development or MVP</p>
              </div>
              <div class="card-price">
                <span class="from" data-es="Desde" data-en="Starting at">Starting at</span>
                <div class="price-row"><span class="currency">$</span><span class="amount text-gradient">3,900</span><span class="unit">USD</span></div>
                <span class="price-note" data-es="Precio base por proyecto · alcance a definir" data-en="Starting price per project · scope to be defined">Starting price per project · scope to be defined</span>
              </div>
              <div class="card-body">
                <p class="pricing-value-statement" data-es="De tu idea a un producto listo para dar el siguiente paso." data-en="From your idea to a product ready to take the next step.">From your idea to a product ready to take the next step.</p>
                <p class="pricing-value-lead" data-es="Estrategia inicial, diseño y desarrollo para convertir lo esencial de tu proyecto en una solución funcional, sin complicaciones." data-en="Initial strategy, design and development to turn the essentials of your project into a functional solution, hassle-free.">Initial strategy, design and development to turn the essentials of your project into a functional solution, hassle-free.</p>
                <p class="pricing-value-description" data-es="Entendemos lo que necesitas lograr, definimos contigo las prioridades y construimos una primera versión útil para validar, operar o lanzar." data-en="We understand what you need to achieve, define priorities with you and build a first useful version to validate, operate or launch.">We understand what you need to achieve, define priorities with you and build a first useful version to validate, operate or launch.</p>
                <p class="pricing-value-highlight" data-es="Una solución bien definida, construida para evolucionar." data-en="A well-defined solution, built to evolve.">A well-defined solution, built to evolve.</p>
                <ul class="features-list">
                  <li class="positive" data-es="✓ Discovery y definición del alcance" data-en="✓ Discovery and scope definition">✓ Discovery and scope definition</li>
                  <li class="positive" data-es="✓ Objetivos de negocio y prioridades del MVP" data-en="✓ Business goals and MVP priorities">✓ Business goals and MVP priorities</li>
                  <li class="positive" data-es="✓ Diseño UX/UI de los flujos esenciales" data-en="✓ UX/UI design of essential flows">✓ UX/UI design of essential flows</li>
                  <li class="positive" data-es="✓ Desarrollo de funcionalidades acordadas" data-en="✓ Development of agreed features">✓ Development of agreed features</li>
                  <li class="positive" data-es="✓ Pruebas funcionales y ajustes de entrega" data-en="✓ Functional testing and delivery adjustments">✓ Functional testing and delivery adjustments</li>
                  <li class="positive" data-es="✓ Despliegue incluido" data-en="✓ Deployment included">✓ Deployment included</li>
                  <li class="positive" data-es="✓ Entrega estimada en 2–4 semanas, según alcance" data-en="✓ Estimated delivery in 2–4 weeks, based on scope">✓ Estimated delivery in 2–4 weeks, based on scope</li>
                  <li class="positive" data-es="✓ Garantía: si no quedas satisfecho, te devolvemos tu dinero" data-en="✓ Guarantee: satisfaction or your money back">✓ Guarantee: satisfaction or your money back</li>
                </ul>
                <p class="price-subnote" data-es="El precio inicial, los tiempos y los entregables dependen del alcance definido en la propuesta." data-en="Initial pricing, timelines and deliverables depend on the scope defined in the proposal.">Initial pricing, timelines and deliverables depend on the scope defined in the proposal.</p>
              </div>
              <div class="card-footer">
                <div class="card-compare">
                  <span class="compare-label" data-es="Agencias Tradicionales" data-en="Traditional Agencies">Traditional Agencies</span>
                  <span class="compare-value">$15,000 - $35,000+ USD</span>
                </div>
                <div class="card-compare inhouse">
                  <span class="compare-label" data-es="In-House (4 meses)" data-en="In-House (4 months)">In-House (4 months)</span>
                  <span class="compare-value">~$28,000+ USD</span>
                </div>
                <a href="#contacto" class="btn-outline btn-card" data-es="Cotizar mi proyecto →" data-en="Quote my project →">Quote my project →</a>
              </div>
            </div>

            <!-- Plan Fractional Team preservado para posible reutilización futura; no se muestra ni ofrece actualmente. -->
            <div class="pricing-card glass-panel" hidden aria-hidden="true">
              <div class="card-top">
                <div class="card-title-hz">
                  <div class="plan-icon">🔄</div>
                  <h3>Fractional Team</h3>
                </div>
                <p class="plan-desc">Desarrollo y Evolución Continua</p>
              </div>
              <div class="card-price">
                <span class="from">Desde</span>
                <div class="price-row"><span class="currency">$</span><span class="amount text-gradient">799</span><span class="unit">USD/mes</span></div>
                <span class="price-note">Contrato mínimo de 6 meses</span>
              </div>
              <div class="card-body">
                <ul class="features-list">
                  <li class="positive" style="font-weight:700;">✓ Todo lo del plan MVP, además:</li>
                  <li class="positive">✓ Diseño y desarrollo continuo</li>
                  <li class="positive">✓ Entregas de valor cada 14 días</li>
                  <li class="positive">✓ Soporte técnico y resolución de bugs</li>
                </ul>
                <p class="price-subnote">Sin contador de hrs ni incertidumbre: defines prioridades y nosotros entregamos cada semana.</p>
              </div>
              <div class="card-footer">
                <div class="card-compare">
                  <span class="compare-label">Agencias Tradicionales</span>
                  <span class="compare-value">$3,500 - $6,500 USD/mes</span>
                </div>
                <div class="card-compare inhouse">
                  <span class="compare-label">1 Dev In-House</span>
                  <span class="compare-value">+$2,800 USD/mes</span>
                </div>
                <a href="#contacto" class="btn-primary btn-card">Comenzar ahora →</a>
              </div>
            </div>

            <!-- Plan principal: célula de desarrollo / producto -->
            <div class="pricing-card glass-panel featured">
              <div class="card-badge-top" data-es="MÁS POPULAR" data-en="MOST POPULAR">MOST POPULAR</div>
              <div class="card-top">
                <div class="card-title-hz">
                  <div class="plan-icon">🏢</div>
                  <h3>10x Dev Squad</h3>
                </div>
                <p class="plan-desc" data-es="Tu célula de producto y desarrollo a la medida" data-en="Your custom product and development squad">Your custom product and development squad</p>
              </div>
              <div class="card-price">
                <span class="from" data-es="Desde" data-en="Starting at">Starting at</span>
                <div class="price-row"><span class="currency">$</span><span class="amount text-gradient">4,900</span><span class="unit">USD/mo</span></div>
                <span class="price-note" data-es="Precio base mensual · célula a la medida" data-en="Starting monthly price · tailored squad">Starting monthly price · tailored squad</span>
              </div>
              <div class="card-body">
                <p class="pricing-value-statement" data-es="Mucho más que un equipo de desarrollo." data-en="Much more than a development team.">Much more than a development team.</p>
                <p class="pricing-value-lead" data-es="Estrategia de negocio, producto, diseño, ingeniería e inteligencia artificial trabajando para hacer crecer tu empresa. Sin contratar y sin coordinar un equipo." data-en="Business strategy, product, design, engineering and AI working to grow your business. Without hiring or managing a team.">Business strategy, product, design, engineering and AI working to grow your business. Without hiring or managing a team.</p>
                <p class="pricing-value-description" data-es="Nuestro Dev Squad entiende tus objetivos, analiza oportunidades, propone soluciones y convierte las mejores ideas en productos digitales que evolucionan con tu negocio." data-en="Our Dev Squad understands your goals, analyzes opportunities, proposes solutions and turns the best ideas into digital products that evolve with your business.">Our Dev Squad understands your goals, analyzes opportunities, proposes solutions and turns the best ideas into digital products that evolve with your business.</p>
                <p class="pricing-value-highlight" data-es="Tu equipo de estrategia y tecnología, en un solo lugar." data-en="Your strategy and technology team, all in one place.">Your strategy and technology team, all in one place.</p>
                <ul class="features-list">
                  <li class="positive" data-es="✓ Estrategia de negocio y visión de producto" data-en="✓ Business strategy and product vision">✓ Business strategy and product vision</li>
                  <li class="positive" data-es="✓ Product Management y roadmap estratégico" data-en="✓ Product Management and strategic roadmap">✓ Product Management and strategic roadmap</li>
                  <li class="positive" data-es="✓ Diseño UX/UI y desarrollo continuo" data-en="✓ UX/UI design and continuous development">✓ UX/UI design and continuous development</li>
                  <li class="positive" data-es="✓ Ingeniería, arquitectura e integraciones" data-en="✓ Engineering, architecture and integrations">✓ Engineering, architecture and integrations</li>
                  <li class="positive" data-es="✓ Entregas de valor cada 14 días" data-en="✓ Value delivery every 14 days">✓ Value delivery every 14 days</li>
                  <li class="positive" data-es="✓ QA, soporte técnico y resolución de bugs" data-en="✓ QA, technical support and bug fixes">✓ QA, technical support and bug fixes</li>
                  <li class="positive" data-es="✓ Especialistas en IA, datos e industria según necesidad" data-en="✓ AI, data and industry specialists as needed">✓ AI, data and industry specialists as needed</li>
                  <li class="positive" data-es="✓ Evolución tecnológica pensada para el futuro" data-en="✓ Technological evolution built for the future">✓ Technological evolution built for the future</li>
                </ul>
                <p class="price-subnote" data-es="La composición del equipo, su dedicación y los entregables se definen según las necesidades y el alcance del proyecto." data-en="Team composition, dedication and deliverables are defined according to project needs and scope.">Team composition, dedication and deliverables are defined according to project needs and scope.</p>
              </div>
              <div class="card-footer">
                <div class="card-compare">
                  <span class="compare-label" data-es="Agencias Tradicionales" data-en="Traditional Agencies">Traditional Agencies</span>
                  <span class="compare-value">$12,000 - $25,000 USD/mes</span>
                </div>
                <div class="card-compare inhouse">
                  <span class="compare-label" data-es="Célula In-House" data-en="In-House Squad">In-House Squad</span>
                  <span class="compare-value">+$14,000 USD/mes</span>
                </div>
                <a href="#contacto" class="btn-primary btn-card" data-es="Diseñemos tu estrategia tecnológica →" data-en="Let's design your tech strategy →">Let's design your tech strategy →</a>
              </div>
            </div>
          </div>
          <div class="pricing-cta-bottom text-center">
            <p class="text-muted" style="margin-bottom: 2rem; max-width: 600px; margin-left: auto; margin-right: auto; font-style: italic;">
              “Choosing a low-cost tool instead of a 10xTeam-built asset can be the difference between having a website and building a scalable business.”
            </p>
            <a href="#" class="open-salary-modal btn-ghost">
              <span class="icon">📊</span> See how we compare with an in-house team
            </a>
          </div>
        </div>
      </section>

      <!-- ════ METODOLOGÍA ════ -->
      <section id="metodologia" class="section">
        <div class="container">
          <div class="section-header text-center">
            <div class="badge">Our Process</div>
            <h2>From Idea to Product<br />in Weeks, Not Months</h2>
          </div>
          <div class="method-steps">
            <div class="step glass-panel">
              <div class="card-title-hz">
                <div class="step-number">01</div>
                <h3>Discovery</h3>
              </div>
              <p>We learn your business, define MVP scope and agree on timelines, milestones and deliverables. Everything is documented.</p>
            </div>
            <div class="step glass-panel">
              <div class="card-title-hz">
                <div class="step-number">02</div>
                <h3>Setup & Architecture</h3>
              </div>
              <p>We set up scalable infrastructure and assemble the right 10xTeam squad in as little as 48 hours.</p>
            </div>
            <div class="step glass-panel">
              <div class="card-title-hz">
                <div class="step-number">03</div>
                <h3>Weekly Deliverables</h3>
              </div>
              <p>Short sprints with functional, testable progress every week. No last-minute surprises.</p>
            </div>
            <div class="step glass-panel">
              <div class="card-title-hz">
                <div class="step-number">04</div>
                <h3>Launch & Support</h3>
              </div>
              <p>We deploy to production, monitor key metrics and support your product as it evolves.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ════ SECCIÓN: SOBRE NOSOTROS ════ -->
      <section id="sobre-nosotros" class="section section-about">
        <div class="container">
          <div class="section-header">
            <div class="badge">Specialized Expertise</div>
            <h2>A team driven by craft, <span class="text-gradient">without borders</span></h2>
          </div>
          <div class="about-grid">
            <div class="about-content">
              <p>We're more than developers: we're your technology partners. Our multidisciplinary team brings experience from <strong>recognized international companies</strong>, working across programming languages, complex architectures and advanced AI models.</p>
              <p>Our **specialized UX/UI and strategic design team** helps make every product powerful, intuitive and visually polished. We approach each project with a sense of <strong>ownership</strong>, aiming for transparent, fair and technically sound solutions.</p>
              
              <div class="about-countries">
                <div class="country-row">
                  <span class="country-badge">🇲🇽 Mexico</span>
                  <span class="country-badge">🇨🇴 Colombia</span>
                  <span class="country-badge">🇦🇷 Argentina</span>
                  <span class="country-badge">🇻🇪 Venezuela</span>
                </div>
                <div class="country-row">
                  <span class="country-badge">🇮🇳 India</span>
                  <span class="country-badge">🇺🇾 Uruguay</span>
                  <span class="country-badge">🇪🇨 Ecuador</span>
                </div>
              </div>
            </div>
            <div class="about-visual">
              <div class="about-card-stack">
                <div class="a-card glass-panel"><span class="icon">🌍</span> Global Experience</div>
                <div class="a-card glass-panel"><span class="icon">🏗️</span> Multi-Stack & Architecture</div>
                <div class="a-card glass-panel"><span class="icon">🤖</span> Generative AI Pioneers</div>
                <div class="a-card glass-panel"><span class="icon">🤝</span> True Partnership</div>
                <div class="a-card glass-panel"><span class="icon">🛡️</span> Transparency & Fairness</div>
                <div class="a-card glass-panel"><span class="icon">🚀</span> Agile Delivery</div>
