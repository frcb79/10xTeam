      .hero-main-img{width:100%;display:block;border-radius:var(--radius-md);filter:none}
      .terminal{padding:0;overflow:hidden;animation:float 6s ease-in-out infinite}
      .terminal-header{display:flex;gap:6px;padding:1rem 1.2rem;border-bottom:1px solid var(--glass-border)}
      .dot{width:10px;height:10px;border-radius:50%}
      .dot.red{background:#f43f5e}.dot.yellow{background:#eab308}.dot.green{background:#10b981}
      .terminal-body{padding:1.5rem;font-family:'Courier New',monospace;font-size:0.85rem;display:flex;flex-direction:column;gap:0.6rem}
      .terminal-body code{display:block;color:var(--text-muted)}
      .t-prompt{color:var(--accent-primary);margin-right:0.5rem}
      .t-accent{color:var(--accent-secondary)}
      .t-success{color:var(--accent-emerald)}
      .t-result{margin-top:0.5rem;padding-top:0.75rem;border-top:1px solid var(--glass-border)}

      /* ─── MODAL ─── */
      .modal-backdrop{position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.8);backdrop-filter:blur(5px);z-index:999;display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity 0.3s ease;}
      .modal-backdrop.active{opacity:1;pointer-events:all;}
      .modal-content{width:90%;max-width:900px;background:var(--bg-color);border:1px solid var(--glass-border);border-radius:var(--radius-lg);padding:2.5rem;position:relative;transform:translateY(20px);transition:transform 0.3s ease;max-height:90vh;overflow-y:auto;}
      .modal-backdrop.active .modal-content{transform:translateY(0);}
      .modal-close{position:absolute;top:1rem;right:1.5rem;background:none;border:none;color:var(--text-muted);font-size:2rem;cursor:pointer;line-height:1;}
      .modal-close:hover{color:var(--text-color);}
      .modal-header h2{font-size:1.8rem;margin-bottom:0.5rem;}
      .modal-columns{display:grid;grid-template-columns:1fr 1fr;gap:2rem;margin-top:1.5rem;}
      .modal-table table{width:100%;border-collapse:collapse;}
      .modal-table th{text-align:left;padding:0.8rem;border-bottom:1px solid var(--glass-border);color:var(--accent-primary);}
      .modal-table td{padding:0.8rem;border-bottom:1px solid rgba(255,255,255,0.05);font-size:0.9rem;color:var(--text-muted);}
      .modal-benefits h3{font-size:1.2rem;margin-bottom:1rem;color:var(--accent-secondary);}
      .benefits-list{list-style:none;padding:0;}
      .benefits-list li{margin-bottom:1rem;font-size:0.9rem;color:var(--text-muted);position:relative;padding-left:1.5rem;}
      .benefits-list li::before{content:"✓";position:absolute;left:0;color:var(--accent-emerald);}
      .benefits-list strong{color:var(--text-color);}
      .modal-footer{margin-top:2rem;text-align:center;padding-top:1.5rem;border-top:1px solid var(--glass-border);}
      @media(max-width:768px){ .modal-columns{grid-template-columns:1fr;} }

      /* Pricing Title Horizontal */
      .card-title-hz{display:flex;align-items:center;gap:1rem;margin-bottom:1.25rem}
      .card-title-hz .plan-icon, .card-title-hz .service-icon, .card-title-hz .step-number{font-size:2rem;margin-bottom:0;flex-shrink:0}
      .card-title-hz h3{font-size:1.35rem;margin-bottom:0;line-height:1.2}
      
      .pricing-cta-bottom { margin-top: 3.5rem; }
      .btn-ghost { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 1rem 2rem; background: rgba(255,255,255,0.03); border: 1px solid var(--glass-border); border-radius: var(--radius-pill); color: var(--text-color); font-weight: 600; font-size: 0.95rem; transition: all 0.3s ease; text-decoration: none; }
      .btn-ghost:hover { background: rgba(59,130,246,0.1); border-color: rgba(59,130,246,0.3); transform: translateY(-2px); color: #fff; }
      .btn-ghost .icon { font-size: 1.2rem; }

      /* ─── SERVICES & METHOD ─── */
      .services-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:2rem}
      .method-grid{grid-template-columns:repeat(4, 1fr); margin-bottom: 4rem;}
      .service-card{padding:2.5rem;transition:transform var(--transition-base),border-color var(--transition-base)}
      .service-card:hover{transform:translateY(-4px);border-color:var(--glass-border-hover)}
      .service-card h3{font-size:1.15rem;margin-bottom:0}
      .service-card p{color:var(--text-muted);font-size:0.92rem;line-height:1.7}

      /* ─── PRICING ─── */
      .section-pricing{background:linear-gradient(180deg,transparent 0%,rgba(59,130,246,.02) 50%,transparent 100%)}
      .pricing-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem;align-items:stretch;max-width:1080px;margin-inline:auto}
      .pricing-card{padding:2rem 1.5rem;display:grid;grid-template-rows:auto auto 1fr auto;position:relative;transition:border-color var(--transition-base),transform var(--transition-base)}
      .pricing-card:hover{border-color:var(--glass-border-hover);transform:translateY(-4px)}
      .pricing-card.featured{border-color:#606ef67a;box-shadow:0 0 60px #4f46e521}
      .pricing-card[hidden]{display:none!important}
      .card-badge-top{position:absolute;top:-14px;left:50%;transform:translateX(-50%);background:linear-gradient(135deg,var(--accent-primary),var(--accent-secondary));padding:.3rem 1.2rem;border-radius:var(--radius-pill);font-size:.7rem;font-weight:700;letter-spacing:1px;color:#fff;white-space:nowrap}
      .card-top{margin-bottom:1.5rem}
      .plan-icon{font-size:2rem;margin-bottom:.75rem}
      .card-top h3{font-size:1.35rem;margin-bottom:.25rem}
      .plan-desc{color:var(--text-muted);font-size:.88rem}
      .card-price{margin-bottom:1.5rem;padding-bottom:1.5rem;border-bottom:1px solid var(--glass-border)}
      .card-body{display:flex;flex-direction:column;gap:1rem;margin-bottom:2rem}
      .section-pricing .pricing-card .card-body{gap:.9rem}
      .pricing-value-statement{margin:0;font-size:1.05rem;line-height:1.4;color:var(--text-color);font-weight:800}
      .pricing-value-lead{margin:0;font-size:.95rem;line-height:1.65;color:var(--text-color);font-weight:700}
      .pricing-value-description{margin:0;font-size:.91rem;line-height:1.7;color:var(--text-muted)}
      .pricing-value-highlight{margin:0;font-size:.94rem;line-height:1.55;color:var(--text-color);font-weight:700}
      .pricing-card .features-list{margin:0;padding:0;list-style:none}
      .pricing-card .features-list li{margin-bottom:.72rem;font-size:.87rem;line-height:1.5}
      .card-footer{display:flex;flex-direction:column;gap:.5rem}
      .card-price .from{font-size:.8rem;color:var(--text-muted);text-transform:uppercase;letter-spacing:.05em}
      .price-row{display:flex;align-items:baseline;gap:.15rem;margin:.25rem 0}
      .currency{font-size:1.4rem;font-weight:700}
      .amount{font-size:2.5rem;font-weight:900;line-height:1}
      .unit{font-size:.85rem;color:var(--text-muted);margin-left:.5rem;font-weight:500}
      .price-note{font-size:.78rem;color:var(--text-dim)}
      .positive{color:var(--accent-emerald)!important;font-weight:500}
      .card-compare{background:#ffffff08;border:1px solid var(--glass-border);border-radius:var(--radius-sm);padding:.6rem .8rem;margin-bottom:.5rem;display:flex;flex-direction:column;gap:.1rem}
      .card-compare.inhouse{background:#f43f5e0a;border-color:#f43f5e1a;margin-bottom:1.5rem}
      .compare-label{font-size:.7rem;color:var(--text-dim);text-transform:uppercase;letter-spacing:.03em}
      .compare-value{font-size:.8rem;color:var(--text-muted);font-weight:600}
      .inhouse .compare-value{color:var(--accent-rose)}
      .price-subnote{font-size:.77rem;color:var(--text-dim);line-height:1.65;margin:0 0 .5rem;font-style:italic}
      .section-pricing .pricing-card .card-footer{margin-top:auto}
      .section-pricing .pricing-card .btn-card{display:flex;justify-content:center;align-items:center;min-height:48px;line-height:1.35}
      .btn-card{width:100%;text-align:center}

      /* ─── METHODOLOGY ─── */
      .method-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:1.5rem}
      .step{padding:2rem;position:relative;transition:border-color var(--transition-base)}
      .step:hover{border-color:var(--glass-border-hover)}
      .step-number{font-size:2.5rem;font-weight:900;line-height:1;background:linear-gradient(135deg,rgba(59,130,246,0.25),rgba(139,92,246,0.15));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
      .step h3{font-size:1.1rem;margin-bottom:0;color:var(--accent-primary)}
      .step p{font-size:0.9rem;color:var(--text-muted);line-height:1.7}

      /* ─── AUDIT SECTION ─── */
      .section-audit { background: linear-gradient(180deg, rgba(59,130,246,0.02) 0%, transparent 100%); }
      .audit-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
      .audit-content p { color: var(--text-muted); line-height: 1.8; margin-bottom: 1.5rem; font-size: 1.05rem; }
      .audit-lead { font-size: 1.15rem; color: var(--text-color); margin-bottom: 1.5rem; }
      .audit-cta-area { margin-top: 2.5rem; }
      .audit-visual { position: relative; }
      .audit-mockup { position: relative; padding: 0.5rem; border-radius: var(--radius-lg); overflow: hidden; }
      .mockup-img { width: 100%; display: block; border-radius: var(--radius-md); filter: brightness(0.9) contrast(1.1); transition: filter 0.3s; }
      .audit-mockup:hover .mockup-img { filter: brightness(1); }
      .mockup-overlay { position: absolute; bottom: 1.5rem; right: 1.5rem; }
      .mockup-tag { background: rgba(0,0,0,0.7); backdrop-filter: blur(5px); padding: 0.5rem 1rem; border-radius: var(--radius-pill); font-size: 0.75rem; color: #fff; font-weight: 600; letter-spacing: 0.5px; border: 1px solid rgba(255,255,255,0.1); }

      /* ─── CONTACT FORM ─── */
      .cta-box{padding:5rem 3rem;background:linear-gradient(135deg,rgba(59,130,246,0.08),rgba(139,92,246,0.08));border-color:rgba(59,130,246,0.15);border-radius:var(--radius-lg)}
      .cta-box h2{font-size:clamp(1.8rem,4vw,2.8rem);margin-bottom:1rem}
      .cta-box .subtitle{margin-bottom:2.5rem}
      .contact-form{max-width: 600px; margin: 0 auto; display: flex; flex-direction: column; gap: 1rem;}
      .form-grid{display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;}
      .contact-form input, .contact-form select, .contact-form textarea{
        padding: 0.8rem 1.2rem;
        background: rgba(0,0,0,0.3);
        border: 1px solid var(--glass-border);
        border-radius: var(--radius-sm);
        color: white;
        font-family: inherit;
      }
      .contact-form textarea{ min-height: 120px; resize: vertical; }
      .contact-form select option { background: var(--bg-color); }
      .form-note{margin-top: 1.5rem; font-size: 0.85rem;}

      /* ─── FOOTER ─── */
      .footer{padding:4rem 0;border-top:1px solid var(--glass-border);margin-top:2rem}
      .footer-inner{display:flex;justify-content:space-between;align-items:center}
      .footer-logo{display:block;margin-bottom:0.5rem;line-height:0}
      .footer-logo img{height:59px;width:auto;display:block;object-fit:contain}
      .footer-links{display: flex; gap: 2rem; align-items: center;}
      .footer-links a{font-size: 0.85rem; color: var(--text-dim); transition: color 0.2s;}
      .footer-links a:hover{color: var(--accent-primary);}
      .footer-agency-link{color: var(--accent-primary) !important; font-weight: 600; text-decoration: underline; text-underline-offset: 4px;}
      .footer-agency-link:hover{color: #fff !important;}

      /* ─── STATS RIBBON ─── */
      .stats-ribbon { background: rgba(59, 130, 246, 0.05); border-top: 1px solid var(--glass-border); border-bottom: 1px solid var(--glass-border); padding: 2rem 0; margin-top: -1px; }
      .stats-container { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; }
      .stat-item { text-align: center; display: flex; flex-direction: column; gap: 0.25rem; }
      .stat-number { font-size: 2rem; font-weight: 800; color: var(--accent-primary); line-height: 1; }
      .stat-label { font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; }

      /* ─── ABOUT US ─── */
      .section-about { overflow: hidden; }
      .about-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 4rem; align-items: center; }
      .about-content { padding-top: 0; }
      .about-content p { color: var(--text-muted); line-height: 1.8; margin-bottom: 1.5rem; font-size: 1.05rem; }
      .about-countries { display: flex; flex-direction: column; gap: 0.75rem; margin-top: 2.5rem; }
      .country-row { display: flex; gap: 0.75rem; flex-wrap: wrap; }
      .country-badge { font-size: 0.95rem; font-weight: 600; color: var(--text-color); background: rgba(59, 130, 246, 0.08); padding: 0.6rem 1.2rem; border-radius: var(--radius-pill); border: 1px solid rgba(59, 130, 246, 0.3); box-shadow: 0 4px 15px rgba(0,0,0,0.2); }
      
      .section-about .section-header { margin-bottom: 0.5rem; }
      .about-visual { position: relative; height: 650px; display: flex; align-items: center; justify-content: center; }
      .about-card-stack { position: relative; width: 100%; max-width: 320px; height: 560px; }
      .a-card { position: absolute; padding: 1.25rem 1.5rem; width: 100%; text-align: left; font-weight: 700; transform: rotate(var(--rot)); top: var(--top); left: var(--left); transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); display: flex; align-items: center; gap: 0.75rem; cursor: default; }
      .a-card .icon { font-size: 1.4rem; }
      .a-card:nth-child(1) { --rot: -4deg; --top: 0px; --left: 0; z-index: 7; }
      .a-card:nth-child(2) { --rot: 2deg; --top: 80px; --left: 20px; z-index: 6; opacity: 0.95; }
      .a-card:nth-child(3) { --rot: -2deg; --top: 160px; --left: -15px; z-index: 5; opacity: 0.9; }
      .a-card:nth-child(4) { --rot: 5deg; --top: 240px; --left: 10px; z-index: 4; opacity: 0.85; }
      .a-card:nth-child(5) { --rot: -3deg; --top: 320px; --left: -5px; z-index: 3; opacity: 0.8; }
      .a-card:nth-child(6) { --rot: 4deg; --top: 400px; --left: 15px; z-index: 2; opacity: 0.75; }
      .a-card:nth-child(7) { --rot: -1deg; --top: 480px; --left: -10px; z-index: 1; opacity: 0.7; }
      .a-card:hover { transform: scale(1.1) translateY(-10px) rotate(0); z-index: 10; opacity: 1; border-color: var(--accent-primary); box-shadow: 0 15px 45px rgba(59, 130, 246, 0.3); }

      /* ─── RESPONSIVE ─── */
      @media(max-width:1024px){
        .about-grid { grid-template-columns: 1fr; text-align: center; gap: 4rem; }
        .about-countries { justify-content: center; }
        .about-visual { height: 350px; margin-top: 2rem; }
        .about-card-stack { margin: 0 auto; }
        .hero-inner{grid-template-columns:1fr;text-align:center}
        .hero h1{max-width:100%;margin-left:auto;margin-right:auto}
        .title-part{display:inline; white-space: normal; margin-right: 0.5rem;}
        @media(max-width:768px) { .title-part{display:block; margin-right:0;} }
        .hero-description-area{flex-direction:column;gap:2rem;align-items:stretch;text-align:center;width:100%}
        .hero-text-side, .hero-stats-side{width:100%;max-width:100%}
        .hero-subtitle{margin-left:auto;margin-right:auto}
        .hero-cta{justify-content:center;width:100%}
        .hero-proof{flex-direction:row;justify-content:center;width:100%;max-width:600px}
        .hero-visual{max-width:620px;margin:2rem auto 0}
        .pricing-grid{grid-template-columns:1fr}
        .method-grid, .method-steps{grid-template-columns:repeat(2,1fr)}
        .audit-grid{grid-template-columns:1fr}
      }
      @media(max-width:768px){
        .hero-proof-horizontal{grid-template-columns:repeat(2,minmax(0,1fr));}
        .nav-links{display:none}
        .navbar-container{grid-template-columns:auto auto}
        .hero{padding:5rem 0 3rem;min-height:auto}
        .hero h1{font-size:2rem}
        .method-grid, .method-steps, .form-grid{grid-template-columns:1fr}
        .footer-inner{flex-direction:column;gap:2rem;text-align:center}
      }
    </style>
	</body>
</html>
