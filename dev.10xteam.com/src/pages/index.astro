          if (e.target === salaryModal) salaryModal.classList.remove('active');
        });

        // Modal Agencias
        const agencyModal = document.getElementById('agency-modal');
        const openAgencyBtns = document.querySelectorAll('.open-agency-modal');
        const closeAgencyBtn = document.getElementById('close-agency-modal');

        openAgencyBtns.forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            agencyModal?.classList.add('active');
          });
        });

        closeAgencyBtn?.addEventListener('click', () => {
          agencyModal?.classList.remove('active');
        });

        agencyModal?.addEventListener('click', (e) => {
          if (e.target === agencyModal) agencyModal.classList.remove('active');
        });
      });
